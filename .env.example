# Configurações do banco de dados PostgreSQL
DB_HOST=seu_host_aqui
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Ou use a connection string completa:
# DATABASE_URL=postgresql://postgres:senha@host:porta/railway

# Configurações do servidor
PORT=3001
NODE_ENV=development

# JWT Secret (mude para um valor seguro em produção)
JWT_SECRET=solar_crm_jwt_secret_mude_em_producao

# CORS - URL do frontend
FRONTEND_URL=http://localhost:5173
